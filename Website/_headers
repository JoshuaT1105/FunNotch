# Cloudflare Pages reads this at deploy time. Ignored by every other host, and
# harmless if the site moves.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  # Tells the browser to go straight to HTTPS next time instead of making one
  # unencrypted request and being redirected. Applies to subdomains too, which
  # is safe here because www is the only one and it is already HTTPS.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML is revalidated on every visit. The pages are a few kilobytes, and a
# cached one means a deploy that nobody can see — which has already cost an
# afternoon once on this site.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Assets are cache-busted with ?v=N in the markup, so a week is safe and a
# forgotten bump costs a week rather than a year.
/*.css
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

# The favicon is fetched from a fixed path with no ?v= to bust it, so keep the
# window short — Google recrawls favicons rarely, and a stale one would stick.
/favicon.ico
  Cache-Control: public, max-age=86400

# The builds never change under a given filename — the version is in the name.
/*.dmg
  Cache-Control: public, max-age=31536000, immutable

/*.zip
  Cache-Control: public, max-age=31536000, immutable
